# --- Build output ---------------------------------------------------------
# build/ holds binaries, objects, harness builds, branch streams, logs,
# the Python venv and the LaTeX engine (all recreated by the scripts).
build/
champsim/bin/
champsim/obj/
champsim/results_*/
champsim/scripts/wget-log*

# --- Traces (16 GB for the 50 traces; download them, see README) ------------
champsim/dpc3_traces/
*.champsimtrace.xz*
*.br
*.part

# --- Unfinished or bookkeeping files from simulation runs -------------------
*.partial
experiments/results/*.started
experiments/results/*.finished

# --- LaTeX intermediates (the final PDF is committed) ----------------------
report_50trace/main.*
!report_50trace/main.tex

# --- Python / editor / OS ---------------------------------------------------
__pycache__/
*.pyc
.venv/
venv/
.claude/settings.local.json
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
